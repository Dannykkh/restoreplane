# .gitignore — 리포 정책: 도구 코드만 공개, config/wrap/복구코드/catalog/keyfile/스풀은 로컬
/target
/target-*/
/.tmp/
restoreplane.toml
# Preserve pre-rename local developer config without committing credentials.
apps/console/src-tauri/dbbackup.toml
prune.toml
*.dek
*.recovery-code
*.keyfile
keystore.json
*.keystore.json
catalog.sqlite*
spool/
.staging/
# 예외: config/*.example.toml 은 secret 없는 예시라 커밋 대상

# 세션/장기기억 아티팩트 — 로컬 전용 (공개 리포 정책)
/.claude/
/.termsnap/
/memory/
/conversations/
/MEMORY.md
/codemap/

# TermSnap (자동 생성 — 코드맵/메모리/대화/핸드오프)
docs/handoffs/

# GUI(apps/console) 빌드 아티팩트 — 소스만 커밋
apps/console/node_modules/
apps/console/dist/
apps/console/src-tauri/gen/
apps/console/src-tauri/target/
apps/console/test-results/
apps/console/playwright-report/
.playwright-mcp/
# 디자인 검증용 스크린샷(로컬 전용)
/dashboard-*.png
# Generated gate evidence and local browser captures are not source identity inputs.
/artifacts/
/*.png
# Raw agent review transcripts and prompts are local generation inputs.
docs/**/*.stdout.log
docs/**/*.stderr.log
docs/**/reviews/*prompt.txt
docs/**/team-reviews/*prompt.txt
# cargo-cyclonedx writes one generated BOM beside each workspace Cargo.toml.
**/bom.json
**/*.cdx.json


# TermSnap (자동 생성 — 코드맵/메모리/대화/핸드오프)
.orchestrator/
